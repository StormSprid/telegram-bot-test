TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_WEBHOOK_SECRET=your_secret_here
DO_API_KEY=your_do_api_key_here
LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
APP_ENV=production
LOG_LEVEL=INFO
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.10
SEMANTIC_WEIGHT=0.35
MAX_HISTORY_MESSAGES=8
RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW_SEC=60
STREAM_ENABLED=true
STREAM_EDIT_INTERVAL_TOKENS=20
OWNER_CHAT_ID=your_telegram_chat_id_here
# Get your chat_id by sending /start to @userinfobot in Telegram
